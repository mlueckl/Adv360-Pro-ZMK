#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <60 67 68 75 6>;
        };
    };

    macros {
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&none      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &mo 3                                                                                        &tog 4         &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T   &kp LG(LS(P))                                                                                &none          &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp ESC    &kp A   &kp S   &kp D   &kp F   &kp G   &kp LG(P)      &kp LEFT_COMMAND  &kp LEFT_CONTROL      &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &kp LG(SPACE)  &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B                                    &kp LEFT_ALT          &kp RIGHT_ALT                                        &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&mo 2      &none   &none   &none   &none           &kp BSPC       &kp DEL           &mo 1                 &mo 1              &kp ENTER          &kp SPACE              &none   &none      &none    &none     &mo 2
            >;
        };

        Symbols {
            bindings = <
&none   &none            &none        &none      &none       &none        &none                                                                                   &none                              &none      &none      &none         &none       &none          &none
&none   &none            &none        &none      &none       &none        &none                                                                                   &none                              &kp CARET  &none      &kp ASTERISK  &kp PLUS    &none          &kp NON_US_BACKSLASH
&none   &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT  &none  &kp K_MUTE        &kp C_VOLUME_UP        &none  &hm RIGHT_BRACKET LEFT_BRACKET   &none                              &kp AMPS   &kp MINUS  &kp UNDER     &kp EQUAL   &kp SEMICOLON  &kp SQT
&trans  &none            &none        &kp TILDE  &kp GRAVE   &none                                 &kp C_VOLUME_DOWN      &none                                                                      &none      &none      &kp COMMA     &kp PERIOD  &kp SLASH      &none
&trans  &none            &none        &none      &none                    &none  &kp C_PLAY_PAUSE  &none                  &none  &hm LEFT_BRACE LEFT_PARENTHESIS  &hm RIGHT_BRACE RIGHT_PARENTHESIS             &none      &none         &none       &none          &none
            >;
        };

        Special {
            bindings = <
&none  &none  &none  &none  &none       &none       &none                                                                          &none          &none               &none               &none                 &none                &none  &none
&none  &none  &none  &none  &none       &none       &none                                                                          &none          &kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(UP_ARROW)      &kp LS(RIGHT_ARROW)  &none  &none
&none  &none  &none  &none  &VimSplitV  &VimSplitH  &none   &trans  &none                     &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &none          &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW          &kp RIGHT_ARROW      &none  &none
&none  &none  &none  &none  &none       &none                       &trans                    &none                                               &kp LS(LA(LEFT))    &kp LS(LA(DOWN))    &kp LS(LA(UP_ARROW))  &kp LS(LA(RIGHT))    &none  &none
&none  &none  &none  &none  &none                   &trans  &trans  &kp LS(LG(NUMBER_4))      &none             &kp LG(LEFT)       &kp LG(RIGHT)                      &none               &none                 &none                &none  &none
            >;
        };

        WindowManager {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                                                           &none              &none                   &none                 &none                   &none                    &none  &none
&none  &none  &none  &none  &none  &none  &none                                                                           &kp LA(LC(EQUAL))  &kp LC(LA(U))           &kp LC(LA(I))         &none                   &none                    &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &kp LS(LC(LG(LA(O))))  &kp LS(LC(LA(LG(DOWN_ARROW))))  &kp LA(LC(MINUS))  &kp LA(LC(LEFT_ARROW))  &kp LA(LC(UP_ARROW))  &kp LA(LC(DOWN_ARROW))  &kp LC(LA(RIGHT_ARROW))  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                                                                     &kp LA(LC(J))           &kp LC(LA(K))         &none                   &none                    &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &kp LG(TAB)            &kp LS(LA(LC(LG(UP_ARROW))))    &kp LC(LA(ENTER))                          &none                 &none                   &none                    &none  &none
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                           &trans                  &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_SLASH     &kp KP_MULTIPLY  &none
&none  &none         &none         &none         &none         &none         &bootloader                                                     &bootloader             &none  &kp KP_N7   &kp KP_N8     &kp KP_NUMBER_9  &kp KP_MINUS     &none
&none  &none         &none         &none         &none         &none         &none          &bl BL_CYCLE  &bl BL_INC      &bt BT_CLR  &none  &rgb_ug RGB_MEFS_CMD 5  &none  &kp KP_N4   &kp KP_N5     &kp KP_N6        &kp KP_PLUS      &none
&none  &none         &none         &none         &macro_ver    &none                                      &bl BL_DEC      &none                                      &none  &kp KP_N1   &kp KP_N2     &kp KP_N3        &kp KP_ENTER     &none
&none  &none         &none         &none         &none                       &kp LC(LG(Q))  &none         &bl BL_TOG      &none       &none  &kp KP_N0                      &none       &none         &kp KP_DOT       &none            &none
            >;
        };

        BaseWithHomeRow {
            bindings = <
&kp EQUAL  &kp N1              &kp N2          &kp N3            &kp N4              &kp N5                    &tog 0                                                                                                      &mo 4          &kp N6                     &kp N7               &kp N8             &kp N9           &kp N0                  &kp MINUS
&kp TAB    &kp Q               &kp W           &kp E             &kp R               &kp T                     &kp LS(LG(NUMBER_4))                                                                                        &none          &kp Y                      &kp U                &kp I              &kp O            &kp P                   &kp BSLH
&kp ESC    &hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_CONTROL F  &hm LA(LC(LEFT_SHIFT)) G  &kp LS(LC(LA(LEFT_COMMAND)))  &kp LEFT_COMMAND  &kp LALT              &kp RIGHT_ALT      &kp RIGHT_COMMAND  &kp LG(SPACE)  &hm RA(RC(RIGHT_SHIFT)) H  &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_COMMAND SEMI  &kp SQT
&kp LSHFT  &kp Z               &kp X           &kp C             &kp V               &kp B                                                                     &kp LEFT_CONTROL      &kp RIGHT_CONTROL                                    &kp N                      &kp M                &kp COMMA          &kp DOT          &kp FSLH                &kp RSHFT
&mo 2      &none               &none           &none             &none                                         &kp BSPC                      &kp DEL           &mo 1                 &mo 1              &kp ENTER          &kp SPACE                                 &kp LEFT_ARROW       &kp UP_ARROW       &kp DOWN_ARROW   &kp RIGHT_ARROW         &none
            >;
        };
    };
};
