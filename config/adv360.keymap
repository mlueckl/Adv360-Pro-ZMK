#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <305>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        Special {
            bindings = <&mo 2>;
            key-positions = <67 68>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp EQUAL  &kp N1              &kp N2          &kp N3            &kp N4              &kp N5                    &tog 4                                                                                                      &mo 5          &kp N6                     &kp N7               &kp N8             &kp N9           &kp N0                  &kp MINUS
&kp TAB    &kp Q               &kp W           &kp E             &kp R               &kp T                     &kp LS(LG(NUMBER_4))                                                                                        &none          &kp Y                      &kp U                &kp I              &kp O            &kp P                   &kp BSLH
&kp ESC    &hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_CONTROL F  &hm LA(LC(LEFT_SHIFT)) G  &kp LS(LC(LA(LEFT_COMMAND)))  &kp LEFT_COMMAND  &kp LALT              &kp RIGHT_ALT      &kp RIGHT_COMMAND  &kp LG(SPACE)  &hm RA(RC(RIGHT_SHIFT)) H  &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_COMMAND SEMI  &kp SQT
&kp LSHFT  &kp Z               &kp X           &kp C             &kp V               &kp B                                                                     &kp LEFT_CONTROL      &kp RIGHT_CONTROL                                    &kp N                      &kp M                &kp COMMA          &kp DOT          &kp FSLH                &kp RSHFT
&mo 3      &none               &none           &none             &none                                         &kp BSPC                      &kp DEL           &mo 1                 &mo 1              &kp ENTER          &kp SPACE                                 &kp LEFT_ARROW       &kp UP_ARROW       &kp DOWN_ARROW   &kp RIGHT_ARROW         &none
            >;
        };

        Symbols {
            bindings = <
&trans            &trans           &trans       &trans     &trans      &trans       &kp LC(LG(Q))                                                                         &trans     &trans     &trans          &trans            &trans                &trans                 &trans
&trans            &kp LG(Q)        &kp LG(W)    &kp LG(E)  &kp LG(R)   &kp LG(T)    &trans                                                                                &trans     &trans     &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&kp GRAVE         &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT  &trans         &kp K_MUTE        &kp C_VOLUME_UP        &kp UP_ARROW  &kp DOWN_ARROW  &trans     &kp CARET  &kp AMPERSAND   &kp ASTERISK      &kp MINUS             &kp EQUAL              &trans
&kp LEFT_ALT      &kp LG(Z)        &kp LG(X)    &kp LG(C)  &kp LG(V)   &trans                                        &kp C_VOLUME_DOWN      &trans                                   &trans     &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &kp RIGHT_SHIFT
&kp LEFT_COMMAND  &none            &none        &none      &none                    &none          &kp K_PLAY_PAUSE  &trans                 &trans        &kp LEFT_ARROW  &kp RIGHT             &none           &none             &none                 &none                  &trans
            >;
        };

        Special {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans         &trans         &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp LA(LG(U))  &trans         &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LA(LG(V))  &kp LG(LA(H))  &kp LA(LG(G))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans         &trans         &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans         &trans         &trans         &trans  &trans
            >;
        };

        WindowManager {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                          &trans             &trans                  &trans                &trans                  &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                          &trans             &kp LC(LA(U))           &kp LC(LA(I))         &trans                  &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LS(LC(LA(DOWN_ARROW)))  &trans             &kp LA(LC(LEFT_ARROW))  &kp LA(LC(UP_ARROW))  &kp LA(LC(DOWN_ARROW))  &kp LC(LA(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                                                 &kp LA(LC(J))           &kp LC(LA(K))         &trans                  &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &kp LS(LA(LC(UP_ARROW)))    &kp LC(LA(ENTER))                          &trans                &trans                  &trans                   &trans  &trans
            >;
        };

        keypad {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                      &mo 5      &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                       &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none   &trans  &trans      &trans  &trans  &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                   &trans      &trans                     &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 0      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &trans  &trans  &trans      &trans  &trans  &kp KP_N0         &none       &none         &kp KP_DOT     &none            &mo 0
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
